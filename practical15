Parent.jsx code-
import Child from "./Child";

function Parent() {

  // Function defined in parent
  function showMessage(name) {
    alert("Hello, " + name + "!");
  }

  return (
    <div>
      <h2>This is Parent Component</h2>

      {/* Passing function as prop */}
      <Child greet={showMessage} />
    </div>
  );
}

export default Parent;
