OrderButton.js [here it is as OrderButton.js

import React from "react";

function OrderButton({ placeOrder }) {

  const sendOrder = () => {
    placeOrder("Pizza");
  };

  return (
    <div>
      <button onClick={sendOrder}>
        Order Pizza
      </button>
    </div>
  );
}

export default OrderButton;
----------------------------------------------------------------------
representation of the life xycle

Old React Lifecycle                                	New React Hook
componentDidMount()	                          useEffect(() => {}, [])
componentDidUpdate()	                       useEffect(() => {}, [state])
componentWillUnmount()	                    return () => {} inside useEffect
